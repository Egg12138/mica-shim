# Micran IO Workflow Deployment Configuration
# Copy this file to .env and update with your actual values
# The .env file is automatically loaded by the Makefile

# Target host for deployment (e.g., root@192.168.7.2)
DEPLOY_HOST=root@192.168.7.2

# Target path for deployment (e.g., /root)
DEPLOY_PATH=/root

# SSH password for the target host (optional - use if using password authentication)
# Leave empty if using SSH keys
DEPLOY_PASS=your_password_here

# Optional: You can also set these as environment variables
# export DEPLOY_HOST=root@192.168.7.2
# export DEPLOY_PATH=/root  
# export DEPLOY_PASS=your_password_here
